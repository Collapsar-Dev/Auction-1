# База данных PostgreSQL 16
DATABASE_URL=postgresql://auction:auction@localhost:5432/auction
# Секреты (в бою — свои длинные случайные значения; KMS_MASTER_KEY — в настоящем KMS)
APP_SECRET=change-me-long-random-string
KMS_MASTER_KEY=change-me-kms-master-key
KYC_WEBHOOK_SECRET=kyc-dev-secret
GATEWAY_WEBHOOK_SECRET=gw-dev-secret
# Адреса
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Режим тестирования: песочницы банка/KYC, страница /dev, коды SMS показываются на экране
DEV_TOOLS=true
DEV_SHOW_CODES=true
# Частота фоновых задач, мс
SCHEDULER_INTERVAL_MS=2000
COOKIE_SECURE=false
